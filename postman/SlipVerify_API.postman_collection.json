{
  "info": {
    "_postman_id": "9a38f712-45e1-4c12-8822-slipverify001",
    "name": "SlipVerify API",
    "description": "Official Postman Collection for SlipVerify API - Automated Thai Bank Slip Verification (https://api.nearbyshop.xyz)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.nearbyshop.xyz",
      "type": "string"
    },
    {
      "key": "apiToken",
      "value": "YOUR_JWT_API_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. POST /slipVerify/v2 (Slip Image + Receiver Check) ⭐",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "slip",
              "type": "file",
              "description": "ไฟล์รูปภาพสลิปโอนเงิน (JPEG, PNG, WEBP)"
            },
            {
              "key": "expected_receiver_name",
              "value": "สมชาย ใจดี",
              "type": "text",
              "description": "ชื่อผู้รับเงินที่คาดหวัง (Optional)"
            },
            {
              "key": "expected_bank_code",
              "value": "KBANK",
              "type": "text",
              "description": "รหัสธนาคาร หรือตัวย่อ เช่น 004 หรือ KBANK (Optional)"
            },
            {
              "key": "expected_account_no",
              "value": "346",
              "type": "text",
              "description": "เลขบัญชีเต็ม หรือเลขท้าย 4 ตัว (Optional)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/slipVerify/v2",
          "host": ["{{baseUrl}}"],
          "path": ["slipVerify", "v2"]
        }
      }
    },
    {
      "name": "2. POST /slipVerify/v1 (QR Payload Only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qr_payload\": \"0046000600000101030140225202609012aGaHuTYRrMykSQkh5102TH910462B0\",\n  \"expected_account_no\": \"346\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/slipVerify/v1",
          "host": ["{{baseUrl}}"],
          "path": ["slipVerify", "v1"]
        }
      }
    }
  ]
}
